rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Birth Registration Records collection
    match /records/{recordId} {
      // Allow reading if authenticated
      allow read: if isSignedIn();
      
      // Allow creating if authenticated and user attaches their uid
      allow create: if isSignedIn() 
        && request.resource.data.keys().hasAll(['id', 'referenceId', 'nameBn', 'nameEn', 'dateOfBirth', 'status'])
        && (request.resource.data.userId == request.auth.uid || !('userId' in request.resource.data));

      // Allow update if authenticated
      allow update: if isSignedIn();

      // Allow delete if authenticated
      allow delete: if isSignedIn();
    }
  }
}
