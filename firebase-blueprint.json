{
  "entities": {
    "Record": {
      "title": "Birth Registration Record",
      "description": "Birth registration certificate draft or verified record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique record ID" },
        "referenceId": { "type": "string", "description": "Reference number e.g. DEMO-20260829-0001" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "userEmail": { "type": "string", "description": "Owner user email" },
        "status": { "type": "string", "enum": ["Draft", "Verified Demo", "Pending Review", "Archived"] },
        "officeNameBn": { "type": "string" },
        "officeNameEn": { "type": "string" },
        "unionParishadBn": { "type": "string" },
        "unionParishadEn": { "type": "string" },
        "upazilaBn": { "type": "string" },
        "upazilaEn": { "type": "string" },
        "districtBn": { "type": "string" },
        "districtEn": { "type": "string" },
        "registrationOfficeBn": { "type": "string" },
        "registrationOfficeEn": { "type": "string" },
        "dateOfRegistration": { "type": "string" },
        "dateOfIssuance": { "type": "string" },
        "nameBn": { "type": "string" },
        "nameEn": { "type": "string" },
        "dateOfBirth": { "type": "string" },
        "dateOfBirthWords": { "type": "string" },
        "sex": { "type": "string" },
        "placeOfBirth": { "type": "string" },
        "placeOfBirthEn": { "type": "string" },
        "motherNameBn": { "type": "string" },
        "motherNameEn": { "type": "string" },
        "motherNationality": { "type": "string" },
        "motherNationalityEn": { "type": "string" },
        "fatherNameBn": { "type": "string" },
        "fatherNameEn": { "type": "string" },
        "fatherNationality": { "type": "string" },
        "fatherNationalityEn": { "type": "string" },
        "villageBn": { "type": "string" },
        "villageEn": { "type": "string" },
        "postOfficeBn": { "type": "string" },
        "postOfficeEn": { "type": "string" },
        "wardBn": { "type": "string" },
        "wardEn": { "type": "string" },
        "unionBn": { "type": "string" },
        "unionEn": { "type": "string" },
        "upazilaFieldBn": { "type": "string" },
        "upazilaFieldEn": { "type": "string" },
        "districtFieldBn": { "type": "string" },
        "districtFieldEn": { "type": "string" },
        "divisionBn": { "type": "string" },
        "divisionEn": { "type": "string" },
        "permanentAddressBn": { "type": "string" },
        "permanentAddressEn": { "type": "string" },
        "assistantTitleBn": { "type": "string" },
        "assistantTitleEn": { "type": "string" },
        "registrarTitleBn": { "type": "string" },
        "registrarTitleEn": { "type": "string" },
        "qrReferenceCode": { "type": "string" },
        "qrVerificationKey": { "type": "string" },
        "barcodeNumber": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "referenceId", "nameBn", "nameEn", "dateOfBirth", "status"]
    }
  },
  "firestore": {
    "/records/{recordId}": {
      "schema": { "$ref": "#/entities/Record" },
      "description": "User created and managed birth registration records and certificates"
    }
  }
}
